+    log_lam = torch.log(lam_desc.clamp_min(1e-12))
+    log_i = torch.log(
+        torch.arange(1, C + 1, device=feature.device, dtype=feature.dtype)
+    )
+    x = log_i - log_i.mean()
+    y = log_lam - log_lam.mean(dim=1, keepdim=True)
+    alpha = -(y * x.unsqueeze(0)).sum(dim=1) / (x ** 2).sum().clamp_min(1e-8)  # [B]
+
