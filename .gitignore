/.worktrees/

# Vendored JavaScript dependencies (found under outputs/ when building tables)
node_modules/

# Microsoft Office lock files
~$*

# Sub-agent scratch state
/.superpowers/


# Regenerable per-worktree inventories (see results/manifests/*/README.md)
results/manifests/*/trees/

# Generated interactive diagrams (archify output, re-creatable)
/.archify/

# Full per-file worktree inventory (1.5 MB, regenerate on demand; summary is committed)
results/manifests/reconciliation-20261112/worktrees.json

# scratch files from the agent session
.tmp_*
